# Copia este archivo como .env.docker y cambia las claves. .env.docker NO se sube a GitHub.

# Django
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# PostgreSQL (los usa el contenedor db para crear la base de datos)
POSTGRES_DB=gregal
POSTGRES_USER=gregal
POSTGRES_PASSWORD=cambia-esta-contrasena

# Dirección de la base de datos para Django: mismo usuario, contraseña y nombre que arriba.
# «db» es el nombre del contenedor de PostgreSQL en docker-compose.yml
DATABASE_URL=postgres://gregal:cambia-esta-contrasena@db:5432/gregal
